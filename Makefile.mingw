clean:
	if exist "$(BUILD_DIR)" rmdir /s /q "$(BUILD_DIR)"
.PHONY: all library clean

$(BUILD_DIR)/neutrino_test_23_wide_bar.exe: examples/neutrino_test_23_wide_bar.cpp $(LIB)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -std=c++17 $< $(LIB) $(LDFLAGS) -luser32 -lgdi32 -lcomctl32 $(LDLIBS) -o $@

