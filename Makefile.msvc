	$(CXX) $(CPPFLAGS) $(CXXFLAGS) examples\neutrino_test_01_buttons_icons.cpp $(LIBRARY) $(SYSTEM_LIBS) /Fo$(OUT)\neutrino_test_01_buttons_icons.obj /Fd$(OUT)\neutrino_test_01_buttons_icons.pdb /Fe$@ /link /SUBSYSTEM:CONSOLE
