$(OUT)\neutrino_test_07_popup_menu_categories.exe: examples\neutrino_test_07_popup_menu_categories.cpp examples\common\Neu_TestCommon.hpp $(LIBRARY)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) examples\neutrino_test_07_popup_menu_categories.cpp $(LIBRARY) $(SYSTEM_LIBS) /Fo$(OUT)\neutrino_test_07_popup_menu_categories.obj /Fd$(OUT)\neutrino_test_07_popup_menu_categories.pdb /Fe$@ /link /SUBSYSTEM:CONSOLE
$(OUT)\neutrino_test_08_richtext_code.exe: examples\neutrino_test_08_richtext_code.cpp examples\common\Neu_TestCommon.hpp $(LIBRARY)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) examples\neutrino_test_08_richtext_code.cpp $(LIBRARY) $(SYSTEM_LIBS) /Fo$(OUT)\neutrino_test_08_richtext_code.obj /Fd$(OUT)\neutrino_test_08_richtext_code.pdb /Fe$@ /link /SUBSYSTEM:CONSOLE
